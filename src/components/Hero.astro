---
import logo from '../../logos/AC_Bruma_IsologoB_Hoja.png';
import { brand } from '../data/site';
---

<section class="hero section-shell" id="inicio" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div class="eyebrow hero-eyebrow" data-hero-in>
      <img src={logo.src} width="28" height="28" alt="" />
      <span>BRUMA <i>/</i> {brand.descriptor}</span>
    </div>
    <h1 class="display-title" id="hero-title" data-hero-in>
      Tu espacio,<br />
      <span>mejor.</span>
    </h1>
    <p class="hero-description" data-hero-in>
      Reformas y reparaciones para mejorar tu hogar, renovar tus espacios y solucionar lo que
      necesitas.
    </p>
    <div class="hero-actions" data-hero-in>
      <a class="button button--accent" href="#datos-de-contacto">
        Solicitar presupuesto <span class="button-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="#servicios">
        Descubrir nuestros servicios <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="hero-coordinate" aria-hidden="true">
      <span class="coordinate-line"></span>
      <span>REFORMAR · REPARAR · MEJORAR</span>
    </div>
  </div>

  <div class="hero-visual" data-hero-image>
    <img
      src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1800&q=85"
      alt="Salón de vivienda renovado con luz natural y materiales cálidos, imagen de referencia"
      width="1800"
      height="1200"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-image-caption">
      <span>UN HOGAR QUE SE SIENTE MEJOR</span>
      <span>REF. 01</span>
    </div>
    <div class="hero-image-mark" aria-hidden="true">B.</div>
    <span class="hero-reference">Imagen provisional · no es un trabajo de BRUMA</span>
  </div>

  <a class="scroll-cue" href="#servicios" aria-label="Desplazarse a servicios">
    <span>DESLIZA PARA DESCUBRIR</span>
    <span class="scroll-cue-line" aria-hidden="true"></span>
  </a>
</section>
